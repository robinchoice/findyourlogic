# Environment variables of the Coolify resource.
# IMAGE_PREFIX and IMAGE_TAG are set by the CI on every deploy.

# Public URL without trailing slash
APP_URL=https://findyourlogic.pleasance.org

# true lets anyone create an account. Closed by default: only existing
# accounts log in, magic links go out only to known addresses.
SIGNUPS_OPEN=false

# Comma-separated. Admins see feedback screenshots. Never admin@pleasance.org,
# the test account of the agents.
ADMIN_EMAILS=robin@pleasance.org

# openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME
# Memory limit of Postgres, default 512m
POSTGRES_MEMORY=

# Required, the API does not start without SMTP_HOST.
# Proton SMTP: the password is the SMTP token of the sender address.
# Business senders use noreply@pleasance.org, private ones noreply@diespaetzles.lol.
SMTP_HOST=smtp.protonmail.ch
SMTP_PORT=587
SMTP_USER=noreply@pleasance.org
SMTP_PASS=CHANGE_ME
EMAIL_FROM=findyourlogic <noreply@pleasance.org>

# Feedback button: reports are mailed here, replies reach the tester.
FEEDBACK_EMAIL=
# Fine-grained GitHub token that may only write issues, from ~/.secrets
# (GITHUB_FEEDBACK_TOKEN). Without it, no issues.
FEEDBACK_GITHUB_TOKEN=

# nsec of the app's Nostr key, signs the notes of requests that opted in.
# From ~/.secrets (NOSTR_FINDYOURLOGIC_SECRET_KEY). Without it, notes go to the log.
NOSTR_SECRET_KEY=

# GlitchTip DSN of this project, used by API, web server and browser
SENTRY_DSN=
PUBLIC_SENTRY_DSN=

# PostHog project key (phc_…) of the shared prototypes project. Empty = no analytics.
PUBLIC_POSTHOG_KEY=
