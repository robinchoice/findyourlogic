# Local dev. Copy to .env, then: docker compose up -d && bun run dev
DATABASE_URL=postgresql://app:app@localhost:5444/app
APP_URL=http://localhost:5173
# false closes the app to new accounts, existing ones still log in
SIGNUPS_OPEN=true
# Comma-separated. Admins see feedback screenshots.
ADMIN_EMAILS=

# Optional in dev: without SMTP_HOST login links are printed to the API log.
# In production (NODE_ENV=production) the API refuses to start without it.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Optional: nsec of the app's Nostr key. Empty = request notes go to the API log.
NOSTR_SECRET_KEY=

# Optional. Empty DSN = GlitchTip off.
SENTRY_DSN=
